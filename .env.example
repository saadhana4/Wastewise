# ==========================================
# WasteWise Environment Configuration Template
# Copy this file to .env before starting the services
# ==========================================

# ------------------------------------------
# Database Configuration (PostgreSQL + PostGIS)
# ------------------------------------------
POSTGRES_USER=wastewise_user
POSTGRES_PASSWORD=wastewise_secure_password
POSTGRES_DB=wastewise_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full SQLAlchemy / GeoAlchemy Database URL
# Format: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql+psycopg://wastewise_user:wastewise_secure_password@localhost:5432/wastewise_db

# ------------------------------------------
# Backend API Configuration (FastAPI)
# ------------------------------------------
PROJECT_NAME="WasteWise Backend"
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
